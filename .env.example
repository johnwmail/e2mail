# ============================================================
# e2mail 環境變數設定（複製做 .env 再填）
#   cp .env.example .env
# docker compose 會自動讀取 .env
# ============================================================

# --- 服務 ---
PORT=8080
DATA_DIR=/data
SESSION_TTL_HOURS=24
# 32-byte AES-GCM key（不設置則隨機生成；多實例部署建議設固定值）
# 支援 raw 32字元 / base64 44字元 / hex 64字元
# SESSION_SECRET=
# Cookie Secure flag（本地 HTTP 開發設為 false，生產 HTTPS 保持 true）
# COOKIE_SECURE=true

# --- Host allow-list（只回應指定 domain；建議生產設定） ---
# 逗號分隔；留空 = 不限制。其他 Host 一律回 421，擋走用錯 Host header 嘅掃描器。
# 反向代理（relayd / nginx）必須保留原本 Host header 傳去 backend。
# ALLOWED_HOSTS=mail.example.com

# --- 伺服器預設值（登入頁預填；自訂網域登入用） ---
# DEFAULT_IMAP_HOST=mail.example.com
# DEFAULT_IMAP_PORT=993
# DEFAULT_SMTP_HOST=mail.example.com
# DEFAULT_SMTP_PORT=587
# DEFAULT_ALLOW_INSECURE_TLS=false
# DEFAULT_SIEVE_HOST=mail.example.com
# DEFAULT_SIEVE_PORT=4190
# DEFAULT_SIEVE_USE_TLS=true
# DEFAULT_SIEVE_ALLOW_INSECURE_TLS=false
# SIEVE_DEBUG=true                      # 排障用：記錄 ManageSieve 協議往來（憑證自動遮蔽）

# --- Onboarding 強制設定（新帳號首次登入） ---
# true = 強制要求設 2FA / PGP；false = 唔強制（可選）
# REQUIRE_2FA=true
# REQUIRE_PGP=true

# --- SQLite 自動備份（寫入 $DATA_DIR/backups/；WAL-safe VACUUM INTO） ---
# DISABLE（預設）/ DAILY（保留 7 份）/ WEEKLY（保留 4 份）/ MONTHLY（保留 12 份）
# DB_BACKUP=DISABLE

# --- LDAP 變更密碼（OpenBSD ldapd；詳見 docs/LDAP.md） ---
# 啟用後登入用戶可喺 Settings → 安全 變更郵件密碼（同步寫入 ldapd + re-wrap 本地 DEK）
# LDAP_ENABLED=true 時以下四項為必填；未完成設定時功能保持停用
# LDAP_URL=ldaps://ldap.example.com:636      # 或 ldap://host:389 配 LDAP_STARTTLS=true
# LDAP_STARTTLS=false
# LDAP_ROOT_DN=cn=e2mail,dc=example,dc=com   # 服務帳號（ldapd namespace rootdn）
# LDAP_ROOT_PW=changeme                      # ⚠️ 敏感：只經 env/secret 注入，永不 log
# LDAP_USER_DN_TEMPLATE=uid=%s,ou=people,dc=example,dc=com  # %s=全 email，%u=local part
# LDAP_PASSWORD_SCHEME=ssha                  # v1 僅支援 ssha
# LDAP_ALLOW_INSECURE_TLS=false              # 自簽憑證（僅開發，跳過校驗）
# LDAP_CA_FILE=/certs/rootCA.crt             # 自簽 RootCA 路徑（容器內路徑，見 docker-compose volumes）

# --- Passkey / WebAuthn 第二因素（Face ID / Touch ID / Windows Hello / 安全鑰匙） ---
# 詳見 docs/PASSKEY.md。必須經 HTTPS；RP ID 要同 origin 嘅 registrable domain 一致
# （例：網址 https://mail.example.com → WEBAUTHN_RP_ID=mail.example.com）。
# 未設定 = passkey 功能停用；換 domain 會令已註冊 passkey 失效。
# WEBAUTHN_RP_ID=mail.example.com
# WEBAUTHN_RP_ORIGINS=https://mail.example.com
# WEBAUTHN_RP_NAME=e2Mail

# --- Build metadata ---
# VERSION=vdev
# BUILD_TIME=timeless
# COMMIT_HASH=sha-unknown
