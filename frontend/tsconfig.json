{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "*": ["./*"],
      "@e2mail/shared/pgp": ["../shared/src/pgp/index.ts"],
      "@e2mail/shared/i18n": ["../shared/src/i18n/index.ts"],
      "@e2mail/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
